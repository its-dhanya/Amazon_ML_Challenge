# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Challenge data (provided by the organizers) and everything derived from it: large, regenerated by the scripts
dataset/
dataset.zip
Dhanya/data/
Dhanya/output/

# Third-party UniBlocker checkout (only used by the abandoned dense-retrieval experiment)
Dhanya/vendor/

# Abandoned DuckDB full-text-search experiments (OOM on every query; superseded by s4sparse.py)
Dhanya/s4duckdb.py
Dhanya/eval_duckdb.py
Dhanya/scratch_duck.py

# Problem statement handout
ps.pdf

# Per-run results and logs live in Dhanya/runs/<RUN_ID>/ (see Dhanya/runs.py): models, parquet and TSV outputs are
# too large for git. Only small run metadata is tracked.
Dhanya/runs/**
!Dhanya/runs/*/
!Dhanya/runs/*/README.md
!Dhanya/runs/*/config.json
!Dhanya/runs/*/metrics.json
!Dhanya/runs/*/blend.json
!Dhanya/runs/*/STATUS.md

# Virtual environments
.venv/
venv/
env/
